# M3 FLEX / owner-controlled Node server settings.
# Example names only; NEVER commit secret values or real user identifiers.
# Fill only in the deployment's secret/environment manager.
PORT=3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI is closed by default. Keep disabled until actual account access and
# spending limits are tested, and owner authorizes API usage.
FLEX_PAID_AI_ENABLED=false
# Build-time browser opt-in. Remain false even if the server permits paid AI
# until an authenticated staging end-to-end test has passed.
VITE_FLEX_PAID_AI_ENABLED=false
FLEX_AI_ALLOWED_USER_IDS=
FLEX_PUBLIC_ORIGIN=

# Server only, never use a VITE_ prefix for this key.
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional override only if the approved audio identity permits it:
# OPENAI_TTS_VOICE=
